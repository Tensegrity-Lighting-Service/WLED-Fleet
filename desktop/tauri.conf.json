  "identifier": "eu.bedancer.wledfleet",
  "build": {
    "frontendDist": "dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MTlFODZCRUU0NzE1RjgKUldUNEZVZnVhK2daWm1OUDArR2pHNGRMWFZtSE9iRldkcmFkam13d01GSGN3QWZpMmsrb1lOZWMK",
